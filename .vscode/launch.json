{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch Server (Standard)",
      "skipFiles": ["<node_internals>/**"],
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/server.js",
      "runtimeArgs": ["-r", "${workspaceFolder}/backend/config/env.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Server (Nodemon)",
      "runtimeExecutable": "nodemon",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["-r", "${workspaceFolder}/backend/config/env.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug All Tests",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": [
        "--runInBand",
        "--detectOpenHandles"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js"
      },
      "runtimeArgs": ["-r", "${workspaceFolder}/backend/config/env.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Test File",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": [
        "${relativeFile}",
        "--runInBand",
        "--detectOpenHandles"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js"
      },
      "runtimeArgs": ["-r", "${workspaceFolder}/backend/config/env.js"]
    }
  ]
}
